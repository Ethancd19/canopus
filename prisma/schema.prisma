generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "workerd"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id String @id @default(cuid())
  title String
  slug String @unique
  // Storage. cloudinaryId is nullable during the migration and dropped afterwards.
  cloudinaryId     String?
  storageKey       String?  @unique
  published        Boolean  @default(true)
  blurDataUrl      String?
  mimeType         String?
  sizeBytes        Int?
  originalFilename String?
  format Format
  tags String[]
  featured Boolean @default(false)
  order Int @default(0)
  width Int
  height Int
  aspectRatio Float
  caption String?
  location String?
  takenAt DateTime?

  // Digital EXIF
  camera       String?
  lens         String?
  focalLength  String?
  aperture     String?
  shutterSpeed String?
  iso          String?

  // Film specific
  filmStock    String?
  filmFormat   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Format {
  DIGITAL
  FILM_35MM
  FILM_120MM
}