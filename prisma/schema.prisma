generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "workerd"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id String @id @default(cuid())
  title String
  slug String @unique
  storageKey       String   @unique
  published        Boolean  @default(false)
  blurDataUrl      String?
  mimeType         String?
  sizeBytes        Int?
  originalFilename String?
  format Format
  tags String[]
  featured Boolean @default(false)
  order Int @default(0)
  width Int
  height Int
  aspectRatio Float
  caption String?
  location String?
  takenAt DateTime?

  // Digital EXIF
  camera       String?
  lens         String?
  focalLength  String?
  aperture     String?
  shutterSpeed String?
  iso          String?

  // Film specific
  filmStock    String?
  filmFormat   String?

  collections  CollectionPhoto[]
  coverOf      Collection[] @relation("CollectionCover")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Format {
  DIGITAL
  FILM_35MM
  FILM_120MM
}

model Collection {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String?
  coverId     String?
  cover       Photo?            @relation("CollectionCover", fields: [coverId], references: [id])
  published   Boolean           @default(false)
  order       Int               @default(0)
  photos      CollectionPhoto[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CollectionPhoto {
  collectionId String
  photoId      String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photo        Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  @@id([collectionId, photoId])
}