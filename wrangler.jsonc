{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "canopus",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "canopus"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "canopus-photos"
		},
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "canopus-cache"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "bycanopus.com",
			"custom_domain": true
		},
		{
			"pattern": "www.bycanopus.com",
			"custom_domain": true
		}
	],
	"vars": {
		"NEXTJS_ENV": "production"
	}
}